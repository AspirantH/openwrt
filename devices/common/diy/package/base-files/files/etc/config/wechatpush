
config wechatpush 'config'
	option sleeptime '60'
	option debuglevel '1'
	option up_timeout '2'
	option down_timeout '10'
	option timeout_retry_count '2'
	option thread_num '3'
	option jsonpath '/usr/share/wechatpush/api/wpush.json'
	option oui_data '2'
	option get_ipv4_mode '1'
	option ipv4_interface 'pppoe-wan'
	list login_notification 'web_login_failed'
	list login_notification 'ssh_login_failed'
	option login_max_num '1'
	option login_web_black '1'
	option login_ip_black_timeout '0'
	option defaultSortColumn 'uptime'
	option get_ipv6_mode '1'
	option ipv6_interface '@wan6'
	option login_disturb '2'
	option login_notification_delay '3600'
	option login_log_enable '1'
	option enable '1'
	option wpush_apikey 'WPUSHYAQQWthQymx0EuIl4VaFUJ2GJun'
	list device_notification 'online'
	list device_notification 'offline'

