#!/bin/sh
rm -f /etc/init.d/led
mountpoint -q /opt && exit 0

for part in $(blkid -t TYPE=ext4 -o device 2>/dev/null); do
    cur_mount=$(grep "^${part} " /proc/mounts | awk '{print $2}')
    [ -n "$cur_mount" ] && umount "$cur_mount" 2>/dev/null
    mkdir -p /opt
    mount -t ext4 "$part" /opt 2>/dev/null && exit 0
done

mkdir -p /opt/cache
rm -f /etc/rc.local
